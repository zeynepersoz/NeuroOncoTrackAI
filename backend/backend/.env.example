# NeuroOncoTrack-AI Backend — Environment Variables
# Copy to .env and fill in values

# ── Application ──────────────────────────────────────────────
APP_NAME=neurooncotrack-api
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ── Database (PostgreSQL 16) ─────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/neurooncotrack
DATABASE_ECHO=false

# ── Redis 7 ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT (RS256) ──────────────────────────────────────────────
# Paths to RSA key pair for RS256 signing
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_ISSUER=neurooncotrack-api
JWT_AUDIENCE=neurooncotrack-web

# ── Refresh Token ────────────────────────────────────────────
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_TOKEN_COOKIE_SECURE=true
REFRESH_TOKEN_COOKIE_SAMESITE=lax

# ── Password Policy ─────────────────────────────────────────
PASSWORD_MIN_LENGTH=12
PASSWORD_HISTORY_COUNT=5
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# ── Rate Limiting ────────────────────────────────────────────
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
ACCOUNT_LOCK_DURATION_MINUTES=30

# ── MFA ──────────────────────────────────────────────────────
MFA_ISSUER_NAME=NeuroOncoTrack
# Fernet key for encrypting MFA secrets (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
MFA_ENCRYPTION_KEY=

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]
